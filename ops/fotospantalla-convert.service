[Unit]
Description=Fotos en Pantalla - copia H.264 de los videos HEVC para /loop
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Mismo usuario y credenciales de Drive que el álbum; el token compartido
# con Render vive aparte, en /etc/fotospantalla-convert.env (0640 root:abrolista-album).
User=abrolista-album
Group=abrolista-album
WorkingDirectory=/opt/fotospantalla-convert
EnvironmentFile=/etc/abrolista-album.env
EnvironmentFile=/etc/fotospantalla-convert.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=HOME=/run/fotospantalla-convert
RuntimeDirectory=fotospantalla-convert
RuntimeDirectoryMode=0700
CacheDirectory=fotospantalla-convert
CacheDirectoryMode=0700
ExecStart=/opt/abrolista-album/venv/bin/python /opt/fotospantalla-convert/screen_convert_worker.py
Restart=always
RestartSec=10
# Un trabajo por vez, en segundo plano respecto de AbroLista y el álbum.
Nice=15
CPUWeight=20
IOSchedulingClass=idle
IOWeight=20
MemoryHigh=380M
MemoryMax=450M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
